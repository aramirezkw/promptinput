                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ 1i — Aurora Composer (purple) — 1c canvas, breathing focus glow ============ -->
    <div id="1i" style="width:700px;display:flex;flex-direction:column;gap:14px">
      <div style="display:flex;align-items:baseline;gap:10px">
        <span style="font-weight:800;font-size:11px;letter-spacing:.1em;color:#FFFFFF;background:var(--c1);padding:5px 7px;border-radius:4px">1i</span>
        <span style="font-weight:800;font-size:16px;color:var(--h1)">Aurora Composer</span>
        <span style="font-weight:400;font-size:13px;color:var(--sub)">1c canvas, breathing glow on focus</span>
      </div>
      <div style="position:relative;padding:30px 22px 34px">
        <div style="position:absolute;left:26px;top:10px;width:260px;height:200px;border-radius:50%;background:radial-gradient(circle at 40% 40%,var(--c1g),rgba(103,48,180,0) 68%);filter:blur(40px);animation:glowBreathe 9s ease-in-out infinite;pointer-events:none"></div>
        <div style="position:relative;background:linear-gradient(180deg,var(--card-c1) 0%,var(--card-c2) 62%);border:1px solid var(--c1b);border-radius:18px;padding:26px;box-shadow:var(--sh)">
          <div style="display:flex;align-items:center;gap:14px;padding-bottom:20px">
            <span style="position:relative;flex:none;width:46px;height:46px;border-radius:50%;display:grid;place-items:center">
              <span style="position:absolute;inset:-6px;border-radius:50%;background:conic-gradient(from 0deg,var(--c1),var(--c1h),var(--c1s),var(--c1));filter:blur(9px);opacity:.6;animation:spinSlow 8s linear infinite"></span>
              <span style="position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 0deg,var(--c1),var(--c1h),var(--c1s),var(--c1));animation:spinSlow 8s linear infinite"></span>
              <span style="position:absolute;inset:4px;border-radius:50%;background:var(--card-c2)"></span>
              <span style="position:relative;color:var(--c1)">
                <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="applet-smartplans" size="19" hint-size="19px,19px"></x-import>
              </span>
            </span>
            <span style="display:flex;flex-direction:column;gap:3px">
              <span style="font-size:21px;font-weight:800;color:var(--txt);letter-spacing:-0.01em">{{ i.greeting }}</span>
              <span style="font-size:13.5px;color:var(--c-txt2)">{{ i.subline }}</span>
            </span>
          </div>
          <div style="position:relative;background:var(--fill);border:1px solid var(--c1b);border-radius:14px;padding:16px 16px 12px;transition:border-color .2s ease" style-focus-within="--glow-p:running;--glow-o:1;border-color:var(--c1s)">
            <span style="position:absolute;inset:0;border-radius:14px;pointer-events:none;opacity:var(--glow-o,0)">
              <span style="position:absolute;inset:0;border-radius:14px;box-shadow:0 0 22px 2px var(--c1g),0 0 58px 12px var(--c1g),0 0 120px 30px var(--c1f);will-change:opacity;animation:focusBreathe 3.6s ease-in-out infinite;animation-play-state:var(--glow-p,paused)"></span>
            </span>
            <textarea value="{{ i.text }}" onChange="{{ i.onChange }}" rows="2" placeholder="Ask anything, or describe the outcome you want…" style="position:relative;width:100%;resize:none;background:transparent;border:0;outline:none;color:var(--txt);font-size:16.5px;line-height:1.5"></textarea>
            <div style="position:relative;display:flex;align-items:center;gap:8px;padding-top:6px">
              <button aria-label="Add context" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--brd2);background:transparent;color:var(--c1s);cursor:pointer;display:grid;place-items:center" style-hover="background:var(--c1f)">
                <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="add-circle" size="16" hint-size="16px,16px"></x-import>
              </button>
              <span style="font-size:12.5px;color:var(--c-txt3)">Uses your contacts, listings, and pipeline</span>
              <button onClick="{{ i.send }}" style="margin-left:auto;display:flex;align-items:center;gap:8px;border:0;border-radius:10px;padding:10px 16px;background:var(--c1);color:#FFFFFF;font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 8px 22px var(--c1f);transition:transform .12s ease,background .15s ease" style-hover="background:var(--c1h);transform:translateY(-1px)" style-active="transform:translateY(1px)">Generate <span style="font-size:13px">&#8593;</span></button>
            </div>
          </div>
          <sc-if value="{{ i.idle }}">
            <div style="display:flex;gap:6px;padding:18px 0 14px;flex-wrap:wrap">
              <sc-for list="{{ i.cats }}" as="t" hint-placeholder-count="4">
                <button onClick="{{ t.pick }}" style="border:1px solid {{ t.border }};background:{{ t.bg }};color:{{ t.color }};border-radius:100px;padding:8px 14px;font-size:13px;font-weight:700;cursor:pointer;transition:all .15s ease">{{ t.label }}</button>
              </sc-for>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;min-height:150px">
              <sc-for list="{{ i.prompts }}" as="p" hint-placeholder-count="3">
                <div onClick="{{ p.pick }}" onKeyDown="{{ p.onKey }}" role="button" tabindex="0" style="display:flex;flex-direction:column;gap:10px;background:var(--fill);border:1px solid var(--brd);border-radius:12px;padding:14px;cursor:pointer;transition:all .15s ease" style-hover="background:var(--c1f);border-color:var(--c1s);transform:translateY(-2px)" style-focus-visible="border-color:var(--c1s);outline:2px solid var(--c1s);outline-offset:2px">
                  <span style="width:32px;height:32px;border-radius:8px;background:var(--c1f);color:var(--c1i);display:grid;place-items:center">
                    <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="{{ p.glyph }}" size="17" hint-size="17px,17px"></x-import>
                  </span>
                  <span style="font-size:14px;font-weight:800;color:var(--txt);line-height:1.35;text-wrap:pretty">{{ p.title }}</span>
                  <span style="font-size:12px;color:var(--c-txt3);margin-top:auto">{{ p.meta }}</span>
                </div>
              </sc-for>
            </div>
          </sc-if>
          <sc-if value="{{ i.result }}">
            <div style="display:flex;flex-direction:column;gap:13px;padding-top:18px">
              <div style="display:flex;align-items:center;gap:9px">
                <span style="width:8px;height:8px;border-radius:50%;background:var(--c1s);box-shadow:0 0 12px var(--c1g);animation:dotPulse 2.4s ease-in-out infinite"></span>
                <span style="font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--c-txt2)">Working on it</span>
                <button onClick="{{ i.reset }}" style="margin-left:auto;background:transparent;border:0;color:var(--c1s);font-size:12.5px;font-weight:700;cursor:pointer;padding:0" style-hover="color:var(--c1h)">Start a new request</button>
              </div>
              <div style="background:var(--fill);border:1px solid var(--c1b);border-radius:12px;padding:13px 15px;font-size:14.5px;font-weight:700;color:var(--txt);line-height:1.45;text-wrap:pretty">{{ i.request }}</div>
              <div style="display:flex;flex-direction:column;gap:9px">
                <sc-for list="{{ i.steps }}" as="st" hint-placeholder-count="3">
                  <div style="display:flex;align-items:center;gap:11px">
                    <span style="flex:none;width:19px;height:19px;border-radius:50%;border:1.5px solid {{ st.ring }};background:{{ st.fill }};display:grid;place-items:center;color:#FFFFFF">
                      <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="{{ st.mark }}" size="10" hint-size="10px,10px"></x-import>
                    </span>
                    <span style="font-size:13.5px;color:{{ st.color }};line-height:1.4">{{ st.label }}</span>
                  </div>
                </sc-for>
              </div>
              <div style="display:flex;align-items:center;gap:10px;margin-top:auto">
                <button style="border:0;border-radius:10px;padding:10px 16px;background:var(--c1);color:#FFFFFF;font-size:13.5px;font-weight:800;cursor:pointer;transition:background .15s ease" style-hover="background:var(--c1h)">Review the draft</button>
                <span style="font-size:12px;color:var(--c-txt3)">{{ i.grounding }}</span>
              </div>
            </div>
          </sc-if>
        </div>
      </div>
    </div>

  </div>
</section>

</x-dc>
<script type="text/x-dc" data-dc-script data-props="{&quot;$preview&quot;:{&quot;width&quot;:1600,&quot;height&quot;:1100},&quot;theme&quot;:{&quot;editor&quot;:&quot;enum&quot;,&quot;options&quot;:[&quot;dark&quot;,&quot;light&quot;],&quot;default&quot;:&quot;dark&quot;,&quot;tsType&quot;:&quot;'dark' | 'light'&quot;,&quot;section&quot;:&quot;Display&quot;}}">
const C_CATS = ["Lead Gen", "Listings & Buyer Service", "Transactions", "Leverage & Ops"];
const C_PROMPTS = {
  "Lead Gen": [
    { glyph: "applet-contacts", title: "Contact 5 people in your database", meta: "248 contacts · Contacts" },
    { glyph: "applet-referrals", title: "Find sphere contacts ready to move", meta: "41 in sphere · Referrals" },
    { glyph: "applet-campaigns", title: "Write a just-listed text to 40 leads", meta: "40 leads · Campaigns" }
  ],
  "Listings & Buyer Service": [
    { glyph: "applet-listings", title: "Draft a listing description for 14 Oak", meta: "14 Oak · Listings" },
    { glyph: "applet-opportunities", title: "Build a buyer tour for the Kims", meta: "6 saved homes · Opportunities" },
    { glyph: "applet-reporting", title: "Prep a price-reduction recommendation", meta: "62 days on market · Listings" }
  ],
  "Transactions": [
    { glyph: "applet-tasks", title: "Summarize open items on 3 contracts", meta: "3 contracts · Transactions" },
    { glyph: "warning", title: "Flag deadlines slipping this week", meta: "5 deadlines · Transactions" },
    { glyph: "applet-campaigns", title: "Send closing-week updates to clients", meta: "2 closings · Campaigns" }
  ],
  "Leverage & Ops": [
    { glyph: "applet-smartplans", title: "Turn my follow-up into a SmartPlan", meta: "9 steps · SmartPlans" },
    { glyph: "applet-reporting", title: "Review last month's lead sources", meta: "Last 30 days · Reporting" },
    { glyph: "applet-tasks", title: "Draft an assistant onboarding checklist", meta: "12 tasks · Tasks" }
  ]
};
const C_SNAPSHOT = { name: "Dana", warmLeads: 12, closings: 3 };
const B_ROWS = [
  { glyph: "applet-campaigns", title: "Draft follow-up to new leads", sub: "Uses 12 leads added this week", hint: "\u21B5" },
  { glyph: "applet-listings", title: "Write a listing description", sub: "Pick a listing from Command", hint: "L" },
  { glyph: "applet-reporting", title: "Summarize my pipeline", sub: "Opportunities \u00B7 last 30 days", hint: "P" },
  { glyph: "applet-smartplans", title: "Build a SmartPlan from a goal", sub: "Automates outreach steps", hint: "S" },
  { glyph: "applet-tasks", title: "Check what closes this week", sub: "Transactions \u00B7 deadlines", hint: "T" }
];
const D_ACTIONS = [
  { title: "Call the 3 leads who opened your CMA twice", meta: "Lead Gen \u00B7 ~10 min" },
  { title: "Send the Millers a price-drop update", meta: "Buyer Service \u00B7 ~5 min" },
  { title: "Clear 2 missing docs on 14 Oak", meta: "Transactions \u00B7 ~8 min" },
  { title: "Reconnect with 5 quiet sphere contacts", meta: "Lead Gen \u00B7 ~6 min" }
];
const F_TOKENS = [
  { key: "type", after: "to", options: ["follow-up email", "listing description", "open-house invite", "price-drop note"] },
  { key: "who", after: "in", options: ["past clients", "new leads", "my sphere", "renters turning buyers"] },
  { key: "where", after: "about", options: ["Austin", "Round Rock", "78704", "Lake Travis"] },
  { key: "topic", after: "", options: ["falling rates", "a price change", "the spring market", "a new listing"] }
];
const G_CMDS = [
  { name: "/followup", desc: "Draft follow-ups for a segment of contacts", tag: "contacts" },
  { name: "/listing", desc: "Generate copy, flyer, and social for a listing", tag: "listings" },
  { name: "/pipeline", desc: "Summarize opportunities by stage and value", tag: "reports" },
  { name: "/smartplan", desc: "Turn a goal into an automated plan", tag: "automation" },
  { name: "/cma", desc: "Pull comps and draft a pricing narrative", tag: "listings" },
  { name: "/recap", desc: "Recap a showing, call, or appointment", tag: "notes" }
];

class Component extends DCLogic {
  state = {
    theme: null, aText: "", bQuery: "", bSel: 0, cCat: "Lead Gen", cText: "", cSent: "", dText: "",
    dDone: [false, false, false, false], eOn: true, eText: "",
    fVals: { type: 0, who: 0, where: 0, topic: 0 }, gQuery: "", hOpen: false, hText: "",
    iCat: "Lead Gen", iText: "", iSent: ""
  };

  theme() {
    return this.state.theme || this.props.theme || "dark";
  }
  greeting() {
    const h = new Date().getHours();
    if (h < 12) return "Good morning";
    if (h < 18) return "Good afternoon";
    return "Good evening";
  }
  applyTheme() {
    document.documentElement.dataset.theme = this.theme();
  }
  componentDidMount() { this.applyTheme(); }
  componentDidUpdate() { this.applyTheme(); }

  set = (k) => (ev) => this.setState({ [k]: ev.target.value });
  put = (k, v) => () => this.setState({ [k]: v });

  // Shared by 1c and 1i — the two differ only in their focus treatment, so the
  // bindings are generated from the same shape against different state keys.
  composer(catKey, textKey, sentKey) {
    const s = this.state;
    const cat = s[catKey];
    return {
      text: s[textKey],
      onChange: this.set(textKey),
      greeting: this.greeting() + ", " + C_SNAPSHOT.name,
      subline: "You have " + C_SNAPSHOT.warmLeads + " warm leads and " +
        C_SNAPSHOT.closings + " closings this month",
      send: () => this.setState((st) => ({
        [sentKey]: st[textKey].trim() || C_PROMPTS[st[catKey]][0].title,
        [textKey]: ""
      })),
      reset: this.put(sentKey, ""),
      idle: !s[sentKey],
      result: !!s[sentKey],
      request: s[sentKey],
      grounding: "Grounded in your " + cat.toLowerCase() + " data",
      steps: [
        { label: "Pulled the matching records from Command", done: true },
        { label: "Checked your recent outreach for overlap", done: true },
        { label: "Drafting in your voice", done: false }
      ].map((st) => ({
        label: st.label,
        mark: st.done ? "checkmark" : "",
        ring: st.done ? "var(--c1)" : "var(--brd2)",
        fill: st.done ? "var(--c1)" : "transparent",
        color: st.done ? "var(--c-txt2)" : "var(--txt)"
      })),
      cats: C_CATS.map((label) => {
        const on = label === cat;
        return {
          label,
          bg: on ? "var(--c1f)" : "var(--fill)",
          border: on ? "var(--c1s)" : "var(--brd)",
          color: on ? "var(--txt)" : "var(--c-txt2)",
          pick: this.put(catKey, label)
        };
      }),
      prompts: C_PROMPTS[cat].map((p) => ({
        ...p,
        pick: this.put(textKey, p.title),
        onKey: (ev) => {
          if (ev.key === "Enter" || ev.key === " ") {
            ev.preventDefault();
            this.setState({ [textKey]: p.title });
          }
        }
      }))
    };
  }

  renderVals() {
    const s = this.state;
    const dark = this.theme() === "dark";

    const q = s.bQuery.trim().toLowerCase();
    const rows = B_ROWS.filter((r) => !q || r.title.toLowerCase().includes(q) || r.sub.toLowerCase().includes(q));
    const doneCount = s.dDone.filter(Boolean).length;
    const vals = F_TOKENS.map((t) => t.options[s.fVals[t.key] % t.options.length]);
    const gq = s.gQuery.trim().toLowerCase().replace(/^\//, "");
    const cmds = G_CMDS.filter((c) => !gq || c.name.includes(gq) || c.desc.toLowerCase().includes(gq));

    return {
      themeDark: this.put("theme", "dark"),
      themeLight: this.put("theme", "light"),
      darkBg: dark ? "var(--a1)" : "transparent",
      darkFg: dark ? "#FFFFFF" : "var(--txt3)",
      lightBg: dark ? "transparent" : "var(--a1)",
      lightFg: dark ? "var(--txt3)" : "#FFFFFF",
      a: {
        text: s.aText,
        onChange: this.set("aText"),
        send: () => this.setState({ aText: "" }),
        cats: ["Lead Gen", "Listings & Buyer Service", "Transactions", "Leverage & Operations"].map((label) => ({
          label, pick: this.put("aText", "Show me my best next move in " + label)
        }))
      },
      b: {
        query: s.bQuery,
        onChange: this.set("bQuery"),
        groupLabel: q ? "Matching actions" : "Suggested for you",
        count: rows.length,
        rows: rows.map((r, i) => ({
          ...r,
          bg: i === s.bSel ? "var(--fill2)" : "transparent",
          pick: this.put("bSel", i)
        }))
      },
      c: this.composer("cCat", "cText", "cSent"),
      i: this.composer("iCat", "iText", "iSent"),
      d: {
        text: s.dText,
        onChange: this.set("dText"),
        send: () => this.setState({ dText: "" }),
        progress: doneCount + " of " + s.dDone.length + " done",
        chips: ["Grow my pipeline", "Save me time today", "Win a listing"].map((label) => ({
          label, pick: this.put("dText", label)
        })),
        actions: D_ACTIONS.map((ac, i) => {
          const on = s.dDone[i];
          return {
            ...ac,
            mark: on ? "checkmark" : "",
            ring: on ? "var(--d1)" : "var(--brd2)",
            fill: on ? "var(--d1)" : "transparent",
            color: on ? "var(--txt3)" : "var(--txt)",
            deco: on ? "line-through" : "none",
            toggle: () => this.setState((st) => {
              const next = st.dDone.slice();
              next[i] = !next[i];
              return { dDone: next };
            })
          };
        })
      },
      e: {
        text: s.eText,
        onChange: this.set("eText"),
        toggle: () => this.setState({ eOn: !s.eOn }),
        status: s.eOn ? "Listening" : "Tap to speak",
        transcript: s.eOn
          ? "\u201CText the buyers on 14 Oak that the seller accepted\u2026\u201D"
          : "Ask for a recap, a draft, or your next best action.",
        bars: Array.from({ length: 21 }, (_, i) => {
          const peak = 10 + Math.round(26 * Math.abs(Math.sin((i + 1) * 1.1)));
          return {
            h: peak + "px",
            op: s.eOn ? 1 : 0.28,
            dur: (0.75 + ((i * 7) % 5) * 0.14).toFixed(2) + "s",
            delay: ((i % 7) * 0.09).toFixed(2) + "s"
          };
        })
      },
      f: {
        tokens: F_TOKENS.map((t, i) => ({
          value: vals[i],
          after: t.after,
          cycle: () => this.setState((st) => ({
            fVals: { ...st.fVals, [t.key]: (st.fVals[t.key] + 1) % t.options.length }
          }))
        })),
        preview: "Draft a " + vals[0] + " to " + vals[1] + " in " + vals[2] + " about " + vals[3] + ", in my voice, ready to send from Campaigns.",
        recipes: ["Load a saved recipe", "Reset tokens", "Add a step"].map((label) => ({
          label,
          pick: label === "Reset tokens" ? this.put("fVals", { type: 0, who: 0, where: 0, topic: 0 }) : () => {}
        })),
        freeform: () => {}
      },
      g: {
        query: s.gQuery,
        onChange: this.set("gQuery"),
        cmds: cmds.map((c) => ({ ...c, pick: this.put("gQuery", c.name + " ") })),
        hint: cmds.length ? "\u2191\u2193 to select \u00B7 tab to autocomplete \u00B7 " + cmds.length + " of " + G_CMDS.length + " commands" : "No command matches \u2014 press \u21B5 to ask in plain words instead"
      },
      h: {
        text: s.hText,
        onChange: this.set("hText"),
        toggle: () => this.setState({ hOpen: !s.hOpen }),
        title: s.hOpen ? "Command AI" : "Ask Command AI",
        titleColor: s.hOpen ? "var(--txt)" : "var(--h-txt)",
        radius: s.hOpen ? "16px" : "100px",
        radiusInner: s.hOpen ? "15px" : "99px",
        bodyMax: s.hOpen ? "320px" : "0px",
        bodyOpacity: s.hOpen ? 1 : 0,
        quick: [
          { glyph: "applet-campaigns", label: "Follow up" },
          { glyph: "applet-listings", label: "Listing copy" },
          { glyph: "applet-reporting", label: "Pipeline" },
          { glyph: "applet-smartplans", label: "SmartPlan" }
        ].map((qq) => ({ ...qq, pick: this.put("hText", qq.label + " \u2014 ") })),
        recent: ["Millers closing recap", "Q3 lead sources"].map((label) => ({
          label, pick: this.put("hText", label)
        }))
      }
    };
  }
}

</script>
