                  <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
                    <span style="font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--h-txt5)">Recent</span>
                    <sc-for list="{{ h.recent }}" as="rr" hint-placeholder-count="2">
                      <button onClick="{{ rr.pick }}" style="background:transparent;border:1px solid var(--brd2);border-radius:100px;padding:6px 11px;color:var(--h-txt3);font-size:12px;cursor:pointer;transition:all .15s ease" style-hover="border-color:var(--h1c);color:var(--txt)">{{ rr.label }}</button>
                    </sc-for>
