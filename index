                  <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px">
                    <sc-for list="{{ h.quick }}" as="q" hint-placeholder-count="4">
                      <button onClick="{{ q.pick }}" style="display:flex;flex-direction:column;align-items:center;gap:7px;background:var(--fill);border:1px solid var(--brd);border-radius:10px;padding:12px 6px;cursor:pointer;transition:all .15s ease" style-hover="background:var(--h1g);border-color:var(--h1c);transform:translateY(-2px)">
                        <span style="width:26px;height:26px;border-radius:7px;background:var(--h1g);color:var(--h1i);display:grid;place-items:center">
                          <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="{{ q.glyph }}" size="15" hint-size="15px,15px"></x-import>
