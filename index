<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
<meta name="design_doc_mode" content="canvas">
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
@font-face{font-family:"Mulish";src:url("fonts/Mulish-VariableFont_wght.ttf") format("truetype");font-weight:200 1000;font-style:normal;font-display:swap}
:root{
  --page:#0A0B0D;--h1:#FFFFFF;--sub:#8A9099;
  --txt:#FFFFFF;--txt2:#D6D9DE;--txt3:#8A9099;--txt4:#6C727E;
  --brd:rgba(255,255,255,.09);--brd2:rgba(255,255,255,.12);--line:rgba(255,255,255,.07);
  --fill:rgba(255,255,255,.045);--fill2:rgba(255,255,255,.07);--dash:rgba(255,255,255,.18);
  --sh:0 18px 44px rgba(0,0,0,.55);--sh2:0 28px 64px rgba(0,0,0,.7);
  --card-a:#17181C;--card-b:#1C1D22;--card-c1:#1A1330;--card-c2:#141020;--card-d:#101815;
  --card-e:#1B1512;--card-f:#101722;--card-g:#0C0D0F;--card-g2:#131418;--card-h:rgba(19,26,29,.92);
  --a1:#017C98;--a1h:#0E9AB8;--a1s:#4FC3DC;--a1f:rgba(1,124,152,.18);--a1b:rgba(79,195,220,.5);--a1g:rgba(1,124,152,.55);
  --b1:#5A626E;--b1s:#C8CBD0;--b1g:rgba(226,232,240,.30);
  --c1:#8C58E8;--c1h:#9E71F2;--c1s:#C8A6FF;--c1i:#D9C8FF;--c1f:rgba(200,166,255,.16);--c1b:rgba(200,166,255,.22);--c1g:rgba(140,88,232,.55);--c-txt2:#B3A8CC;--c-txt3:#9A90B3;
  --d1:#2E9E5B;--d1h:#3BB86C;--d1s:#63D18C;--d1g:rgba(56,180,110,.42);--d-txt2:#8FB79F;--d-txt3:#7D8F85;--d-txt4:#B4C6BB;
  --e1:#E88C32;--e1d:#B9560A;--e1s:#F0A868;--e1g:rgba(232,140,50,.40);--e-txt2:#C99A6E;--e-txt3:#9E8C7C;
  --f1:#2F7FD1;--f1h:#4A95E0;--f1s:#78B6F0;--f1i:#A9D2FA;--f1g:rgba(56,132,212,.42);--f-txt:#DDE6F0;--f-txt2:#7E9AB8;--f-txt3:#B7C7D8;--f-txt4:#6C8AA8;--f-txt5:#AFC0D2;
  --g1:#CE011F;--g1s:#FF6B7A;--g1s2:#FF8A96;--g1g:rgba(206,1,31,.38);--g-txt2:#9CA3AD;--g-txt3:#5C626C;
  --h1c:#5EE0E8;--h1a:#017C98;--h1ah:#0FA3C0;--h1i:#8FEFF5;--h1g:rgba(64,200,214,.35);--h-txt:#C3D4D8;--h-txt2:#CFDDE0;--h-txt3:#A9BCC1;--h-txt4:#8FA6AC;--h-txt5:#6F868C;
}
html[data-theme="light"]{
  --page:#F7F7F8;--h1:#282B33;--sub:#6C727E;
  --txt:#282B33;--txt2:#3D424D;--txt3:#6C727E;--txt4:#767C86;
  --brd:rgba(61,66,77,.16);--brd2:rgba(61,66,77,.22);--line:rgba(43,43,51,.1);
  --fill:rgba(43,43,51,.035);--fill2:rgba(43,43,51,.06);--dash:rgba(61,66,77,.25);
  --sh:0 12px 28px rgba(43,43,51,.12);--sh2:0 20px 44px rgba(43,43,51,.18);
  --card-a:#FFFFFF;--card-b:#FFFFFF;--card-c1:#FFFFFF;--card-c2:#FBF9FF;--card-d:#FFFFFF;
  --card-e:#FFFFFF;--card-f:#FFFFFF;--card-g:#FFFFFF;--card-g2:#F7F7F8;--card-h:rgba(255,255,255,.94);
  --a1:#006C84;--a1h:#0E4E5D;--a1s:#006C84;--a1f:rgba(0,108,132,.1);--a1b:rgba(0,108,132,.45);--a1g:rgba(0,108,132,.22);
  --b1:#3D424D;--b1s:#3D424D;--b1g:rgba(61,66,77,.14);
  --c1:#6730B4;--c1h:#7A3FCF;--c1s:#6730B4;--c1i:#6730B4;--c1f:rgba(103,48,180,.1);--c1b:rgba(103,48,180,.2);--c1g:rgba(103,48,180,.2);--c-txt2:#5F5877;--c-txt3:#6C727E;
  --d1:#026E24;--d1h:#0B4C1F;--d1s:#026E24;--d1g:rgba(2,110,36,.2);--d-txt2:#3D6B4E;--d-txt3:#6C727E;--d-txt4:#3D424D;
  --e1:#A73B06;--e1d:#8A3105;--e1s:#A73B06;--e1g:rgba(167,59,6,.2);--e-txt2:#8A5A3C;--e-txt3:#6C727E;
  --f1:#0F5EAD;--f1h:#1D4670;--f1s:#0F5EAD;--f1i:#0F5EAD;--f1g:rgba(15,94,173,.2);--f-txt:#282B33;--f-txt2:#5A7690;--f-txt3:#3D424D;--f-txt4:#6C8AA8;--f-txt5:#3D424D;
  --g1:#CE011F;--g1s:#C5050B;--g1s2:#C5050B;--g1g:rgba(206,1,31,.18);--g-txt2:#3D424D;--g-txt3:#767C86;
  --h1c:#006C84;--h1a:#006C84;--h1ah:#0E4E5D;--h1i:#006C84;--h1g:rgba(0,108,132,.2);--h-txt:#3D424D;--h-txt2:#3D424D;--h-txt3:#3D424D;--h-txt4:#6C727E;--h-txt5:#6C727E;
}
html,body{margin:0;padding:0;background:var(--page)}
*{box-sizing:border-box}
input,textarea,button{font-family:"Mulish",sans-serif}
input::placeholder,textarea::placeholder{color:var(--txt4)}
a{color:var(--a1);text-decoration:none}
a:hover{color:var(--a1h)}
@keyframes glowBreathe{0%,100%{opacity:.5;transform:scale(1)}50%{opacity:.95;transform:scale(1.06)}}
@keyframes glowSlide{0%{transform:translateX(-12%)}50%{transform:translateX(12%)}100%{transform:translateX(-12%)}}
@keyframes spinSlow{to{transform:rotate(360deg)}}
@keyframes ringOut{0%{transform:scale(.7);opacity:.55}100%{transform:scale(1.9);opacity:0}}
@keyframes caret{0%,49%{opacity:1}50%,100%{opacity:0}}
@keyframes bar{0%,100%{transform:scaleY(.22)}50%{transform:scaleY(1)}}
@keyframes sheen{0%{transform:translateX(-140%)}100%{transform:translateX(240%)}}
@keyframes dotPulse{0%,100%{opacity:.35}50%{opacity:1}}
@keyframes shineRing{0%{background-position:0% 0%}50%{background-position:100% 100%}100%{background-position:0% 0%}}
@keyframes focusBreathe{0%,100%{opacity:.7}50%{opacity:1}}</style>
</helmet>

<section style="min-height:100%;padding:64px 64px 120px;background:var(--page);font-family:'Mulish',sans-serif;display:flex;flex-direction:column;gap:14px">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:32px;flex-wrap:wrap">
    <div style="display:flex;flex-direction:column;gap:8px;max-width:820px">
      <div style="font-weight:800;font-size:34px;line-height:1.15;color:var(--h1);letter-spacing:-0.01em">Command AI — Prompt Widget Concepts</div>
      <div style="font-weight:400;font-size:16px;line-height:1.5;color:var(--sub);text-wrap:pretty">Nine distinct takes on the primary prompt surface. Each uses one XDS palette as its accent and a different ambient-glow treatment — <a href="#1i">1i</a> reuses 1c's canvas so the focus treatment is the only variable. Reference a concept by its id in chat — <a href="#1c">1c</a>, <a href="#1f">1f</a>, and so on.</div>
    </div>
    <div style="display:flex;align-items:center;gap:4px;background:var(--fill2);border:1px solid var(--brd);border-radius:100px;padding:4px">
      <button onClick="{{ themeDark }}" style="border:0;border-radius:100px;padding:9px 18px;font-size:13.5px;font-weight:800;cursor:pointer;background:{{ darkBg }};color:{{ darkFg }};transition:all .15s ease">Dark</button>
      <button onClick="{{ themeLight }}" style="border:0;border-radius:100px;padding:9px 18px;font-size:13.5px;font-weight:800;cursor:pointer;background:{{ lightBg }};color:{{ lightFg }};transition:all .15s ease">Light</button>
    </div>
  </div>

  <div style="display:flex;flex-wrap:wrap;gap:56px 48px;align-items:flex-start;padding-top:26px">

    <!-- ============ 1a — Console Bar (teal) ============ -->
    <div id="1a" style="width:680px;display:flex;flex-direction:column;gap:14px">
      <div style="display:flex;align-items:baseline;gap:10px">
        <span style="font-weight:800;font-size:11px;letter-spacing:.1em;color:#FFFFFF;background:var(--a1);padding:5px 7px;border-radius:4px">1a</span>
        <span style="font-weight:800;font-size:16px;color:var(--h1)">Console Bar</span>
        <span style="font-weight:400;font-size:13px;color:var(--sub)">One line, chrome-adjacent, category rail</span>
      </div>
      <div style="position:relative;padding:26px 22px 30px">
        <div style="position:absolute;left:8%;right:8%;top:34px;height:96px;border-radius:100px;background:radial-gradient(ellipse at center,var(--a1g),rgba(1,124,152,0) 70%);filter:blur(34px);animation:glowBreathe 7s ease-in-out infinite;pointer-events:none"></div>
        <div style="position:relative;background:var(--card-a);border:1px solid var(--brd);border-radius:14px;box-shadow:var(--sh)">
          <div style="display:flex;align-items:center;gap:14px;padding:18px 18px 18px 20px">
            <svg viewBox="0 0 24 24" width="20" height="20" style="flex:none;color:var(--a1s)" fill="currentColor"><path d="M12 2.5l1.9 5.1 5.1 1.9-5.1 1.9L12 16.5l-1.9-5.1L5 9.5l5.1-1.9L12 2.5zM19 15l.9 2.3 2.3.9-2.3.9-.9 2.3-.9-2.3-2.3-.9 2.3-.9L19 15z"></path></svg>
            <input value="{{ a.text }}" onChange="{{ a.onChange }}" placeholder="How can I help you grow your business?" style="flex:1;min-width:0;background:transparent;border:0;outline:none;color:var(--txt);font-size:17px;font-weight:400;padding:2px 0" />
            <button aria-label="Voice input" style="flex:none;width:36px;height:36px;border-radius:8px;border:0;background:transparent;color:var(--txt3);cursor:pointer;display:grid;place-items:center" style-hover="background:var(--fill2);color:var(--txt)">
              <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor"><path d="M12 14a3 3 0 003-3V6a3 3 0 10-6 0v5a3 3 0 003 3zm5-3a5 5 0 01-10 0H5a7 7 0 006 6.9V21h2v-3.1A7 7 0 0019 11h-2z"></path></svg>
            </button>
            <button aria-label="Send" onClick="{{ a.send }}" style="flex:none;width:38px;height:38px;border-radius:9px;border:0;background:var(--a1);color:#FFFFFF;cursor:pointer;display:grid;place-items:center;box-shadow:0 6px 18px var(--a1f);transition:transform .12s ease,background .15s ease" style-hover="background:var(--a1h);transform:translateY(-1px)" style-active="transform:translateY(1px)">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 4l7 7-1.5 1.5L13 8v12h-2V8l-4.5 4.5L5 11l7-7z"></path></svg>
            </button>
          </div>
          <div style="height:1px;background:var(--line)"></div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;padding:14px 18px 16px">
            <sc-for list="{{ a.cats }}" as="c" hint-placeholder-count="4">
              <button onClick="{{ c.pick }}" style="display:flex;align-items:center;gap:8px;background:var(--fill);border:1px solid var(--brd);border-radius:100px;padding:9px 14px;color:var(--txt2);font-size:13.5px;font-weight:700;cursor:pointer;transition:all .15s ease" style-hover="background:var(--a1f);border-color:var(--a1b);color:var(--txt)">
                {{ c.label }}
                <span style="color:var(--a1s);font-size:12px">&#8250;</span>
              </button>
            </sc-for>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ 1b — Command Palette (neutral / mono) ============ -->
    <div id="1b" style="width:600px;display:flex;flex-direction:column;gap:14px">
      <div style="display:flex;align-items:baseline;gap:10px">
        <span style="font-weight:800;font-size:11px;letter-spacing:.1em;color:#FFFFFF;background:var(--b1);padding:5px 7px;border-radius:4px">1b</span>
        <span style="font-weight:800;font-size:16px;color:var(--h1)">Command Palette</span>
        <span style="font-weight:400;font-size:13px;color:var(--sub)">Keyboard-first, grouped results</span>
      </div>
      <div style="position:relative;padding:26px 22px 30px">
        <div style="position:absolute;left:14%;right:14%;top:16px;height:70px;border-radius:80px;background:radial-gradient(ellipse at center,var(--b1g),rgba(226,232,240,0) 70%);filter:blur(30px);animation:glowSlide 11s ease-in-out infinite;pointer-events:none"></div>
        <div style="position:relative;background:var(--card-b);border:1px solid var(--brd2);border-radius:12px;overflow:hidden;box-shadow:var(--sh2)">
          <div style="display:flex;align-items:center;gap:12px;padding:16px 16px 14px">
            <span style="font-family:'IBM Plex Mono',monospace;font-size:15px;color:var(--txt4)">&#8250;</span>
            <input value="{{ b.query }}" onChange="{{ b.onChange }}" placeholder="Type a request or pick an action" style="flex:1;min-width:0;background:transparent;border:0;outline:none;color:var(--txt);font-size:15.5px" />
            <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--txt3);background:var(--fill2);border:1px solid var(--brd2);border-radius:5px;padding:4px 7px">&#8984;K</span>
          </div>
          <div style="height:1px;background:var(--line)"></div>
          <div style="padding:12px 10px 8px">
            <div style="padding:4px 10px 8px;font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--txt4)">{{ b.groupLabel }}</div>
            <div style="display:flex;flex-direction:column;gap:2px">
              <sc-for list="{{ b.rows }}" as="r" hint-placeholder-count="4">
                <div onClick="{{ r.pick }}" style="display:flex;align-items:center;gap:12px;padding:10px 10px;border-radius:8px;cursor:pointer;background:{{ r.bg }};transition:background .12s ease" style-hover="background:var(--fill2)">
                  <span style="flex:none;width:28px;height:28px;border-radius:7px;background:var(--fill2);border:1px solid var(--brd);display:grid;place-items:center;color:var(--b1s)">
                    <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="{{ r.glyph }}" size="15" hint-size="15px,15px"></x-import>
                  </span>
                  <span style="flex:1;min-width:0;display:flex;flex-direction:column;gap:2px">
                    <span style="font-size:14.5px;font-weight:700;color:var(--txt)">{{ r.title }}</span>
                    <span style="font-size:12.5px;color:var(--txt3)">{{ r.sub }}</span>
                  </span>
                  <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--txt4)">{{ r.hint }}</span>
                </div>
              </sc-for>
            </div>
          </div>
          <div style="display:flex;align-items:center;gap:16px;padding:11px 16px;background:var(--fill);border-top:1px solid var(--line);font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--txt4);white-space:nowrap">
            <span style="flex:none">&#8593;&#8595; navigate</span>
            <span style="flex:none">&#8629; run</span>
            <span style="flex:none">esc close</span>
            <span style="flex:none;margin-left:auto;color:var(--txt3)">{{ b.count }} actions</span>
          </div>
        </div>
      </div>
    </div>

    <!-- ============ 1c — Orb Composer (purple) ============ -->
    <div id="1c" style="width:700px;display:flex;flex-direction:column;gap:14px">
      <div style="display:flex;align-items:baseline;gap:10px">
        <span style="font-weight:800;font-size:11px;letter-spacing:.1em;color:#FFFFFF;background:var(--c1);padding:5px 7px;border-radius:4px">1c</span>
        <span style="font-weight:800;font-size:16px;color:var(--h1)">Orb Composer</span>
        <span style="font-weight:400;font-size:13px;color:var(--sub)">Greeting, big canvas, switchable playbooks</span>
      </div>
      <div style="position:relative;padding:30px 22px 34px">
        <div style="position:absolute;left:26px;top:10px;width:260px;height:200px;border-radius:50%;background:radial-gradient(circle at 40% 40%,var(--c1g),rgba(103,48,180,0) 68%);filter:blur(40px);animation:glowBreathe 9s ease-in-out infinite;pointer-events:none"></div>
        <div style="position:relative;background:linear-gradient(180deg,var(--card-c1) 0%,var(--card-c2) 62%);border:1px solid var(--c1b);border-radius:18px;padding:26px;box-shadow:var(--sh)">
          <div style="display:flex;align-items:center;gap:14px;padding-bottom:20px">
            <span style="position:relative;flex:none;width:46px;height:46px;border-radius:50%;display:grid;place-items:center">
              <span style="position:absolute;inset:-6px;border-radius:50%;background:conic-gradient(from 0deg,var(--c1),var(--c1h),var(--c1s),var(--c1));filter:blur(9px);opacity:.6;animation:spinSlow 8s linear infinite"></span>
              <span style="position:absolute;inset:0;border-radius:50%;background:conic-gradient(from 0deg,var(--c1),var(--c1h),var(--c1s),var(--c1));animation:spinSlow 8s linear infinite"></span>
              <span style="position:absolute;inset:4px;border-radius:50%;background:var(--card-c2)"></span>
              <span style="position:relative;color:var(--c1)">
                <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="applet-smartplans" size="19" hint-size="19px,19px"></x-import>
              </span>
            </span>
            <span style="display:flex;flex-direction:column;gap:3px">
              <span style="font-size:21px;font-weight:800;color:var(--txt);letter-spacing:-0.01em">{{ c.greeting }}</span>
              <span style="font-size:13.5px;color:var(--c-txt2)">{{ c.subline }}</span>
            </span>
          </div>
          <div style="position:relative;background:var(--fill);border:1px solid var(--c1b);border-radius:14px;padding:16px 16px 12px" style-focus-within="--shine-p:running;--shine-o:1">
            <span style="position:absolute;inset:-1px;border-radius:14px;padding:1.5px;background-image:radial-gradient(transparent,transparent,var(--c1s),var(--c1h),transparent,transparent);background-size:300% 300%;-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);mask-composite:exclude;pointer-events:none;will-change:background-position;animation:shineRing 8s linear infinite;animation-play-state:var(--shine-p,paused);opacity:var(--shine-o,0)"></span>
            <textarea value="{{ c.text }}" onChange="{{ c.onChange }}" rows="2" placeholder="Ask anything, or describe the outcome you want…" style="width:100%;resize:none;background:transparent;border:0;outline:none;color:var(--txt);font-size:16.5px;line-height:1.5"></textarea>
            <div style="display:flex;align-items:center;gap:8px;padding-top:6px">
              <button aria-label="Add context" style="width:32px;height:32px;border-radius:8px;border:1px solid var(--brd2);background:transparent;color:var(--c1s);cursor:pointer;display:grid;place-items:center" style-hover="background:var(--c1f)">
                <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="add-circle" size="16" hint-size="16px,16px"></x-import>
              </button>
              <span style="font-size:12.5px;color:var(--c-txt3)">Uses your contacts, listings, and pipeline</span>
              <button onClick="{{ c.send }}" style="margin-left:auto;display:flex;align-items:center;gap:8px;border:0;border-radius:10px;padding:10px 16px;background:var(--c1);color:#FFFFFF;font-size:14px;font-weight:800;cursor:pointer;box-shadow:0 8px 22px var(--c1f);transition:transform .12s ease,background .15s ease" style-hover="background:var(--c1h);transform:translateY(-1px)" style-active="transform:translateY(1px)">Generate <span style="font-size:13px">&#8593;</span></button>
            </div>
          </div>
          <sc-if value="{{ c.idle }}">
            <div style="display:flex;gap:6px;padding:18px 0 14px;flex-wrap:wrap">
              <sc-for list="{{ c.cats }}" as="t" hint-placeholder-count="4">
                <button onClick="{{ t.pick }}" style="border:1px solid {{ t.border }};background:{{ t.bg }};color:{{ t.color }};border-radius:100px;padding:8px 14px;font-size:13px;font-weight:700;cursor:pointer;transition:all .15s ease">{{ t.label }}</button>
              </sc-for>
            </div>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;min-height:150px">
              <sc-for list="{{ c.prompts }}" as="p" hint-placeholder-count="3">
                <div onClick="{{ p.pick }}" onKeyDown="{{ p.onKey }}" role="button" tabindex="0" style="display:flex;flex-direction:column;gap:10px;background:var(--fill);border:1px solid var(--brd);border-radius:12px;padding:14px;cursor:pointer;transition:all .15s ease" style-hover="background:var(--c1f);border-color:var(--c1s);transform:translateY(-2px)" style-focus-visible="border-color:var(--c1s);outline:2px solid var(--c1s);outline-offset:2px">
                  <span style="width:32px;height:32px;border-radius:8px;background:var(--c1f);color:var(--c1i);display:grid;place-items:center">
                    <x-import component="XdsIcon" from="./xds-icons.jsx" glyph="{{ p.glyph }}" size="17" hint-size="17px,17px"></x-import>
                  </span>
                  <span style="font-size:14px;font-weight:800;color:var(--txt);line-height:1.35;text-wrap:pretty">{{ p.title }}</span>
                  <span style="font-size:12px;color:var(--c-txt3);margin-top:auto">{{ p.meta }}</span>
                </div>
              </sc-for>
            </div>
          </sc-if>
          <sc-if value="{{ c.result }}">
            <div style="display:flex;flex-direction:column;gap:13px;padding-top:18px">
              <div style="display:flex;align-items:center;gap:9px">
